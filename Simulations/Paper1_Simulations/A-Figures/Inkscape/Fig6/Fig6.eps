q
31 18 150 150 re W n
[ 1 0 0 1 0 0 ] concat
  q
q
31 18 150 150 re W n
[ 198.425197 0 0 -178.582656 16.347992 190.009986 ] concat
/cairo_ascii85_file currentfile /ASCII85Decode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Width 2000
  /Height 1800
  /Interpolate true
  /BitsPerComponent 8
  /Decode [ 0 1 0 1 0 1 ]
  /DataSource cairo_ascii85_file /FlateDecode filter
  /ImageMatrix [ 2000 0 0 -1800 0 1800 ]
